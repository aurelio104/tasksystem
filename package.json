{
  "name": "tasksystem",
  "version": "1.0.0",
  "description": "Dashboard MD-80 Task Cards — filtrado, visor PDF e impresión selectiva",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "parse": "tsx src/scripts/parse-pdf.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "setup": "bash scripts/setup.sh",
    "vercel-build": "npm run parse && npm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
